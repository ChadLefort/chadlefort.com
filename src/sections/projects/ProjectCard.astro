---
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import { tv } from 'tailwind-variants';
import { getProjectSkills } from '~/data/project-skills';
import type { Skill } from '~/data/skills';
import { focusRing } from '~/utils/focusRing';
import { skillIcon } from '~/utils/skillIcon';

type ProjectEntry = CollectionEntry<'projects'>;

type Props = {
  project: ProjectEntry;
  index: number;
  featured?: boolean;
  compact?: boolean;
  headingLevel?: 2 | 3;
};

const { project, index, featured = false, compact = false, headingLevel = 3 } = Astro.props;

const mediaFrame = tv({
  base: 'block w-full overflow-hidden rounded-2xl',
  variants: {
    featured: {
      true: 'aspect-video',
      false:  'aspect-video md:aspect-[16/8]'
    }
  }
});

const projectIcon = tv({
  variants: {
    compact: {
      true: '',
      false: ''
    },
    small: {
      true: '',
      false: ''
    }
  },
  compoundVariants: [
    { compact: true, small: true, class: 'size-14 md:size-16' },
    { compact: false, small: true, class: 'size-16 md:size-20' },
    { compact: true, small: false, class: 'size-20 md:size-24' },
    { compact: false, small: false, class: 'size-24 md:size-32' }
  ]
});

const HeadingTag = `h${headingLevel}` as const;
const smallBrandIcons = new Set(['simple-icons:lerna', 'simple-icons:webpack']);
const isSmallBrandIcon = smallBrandIcons.has(project.data.icon ?? '');
const projectSkills = getProjectSkills(project.data.tech);

const initials = project.data.title
  .split(' ')
  .map((word: string) => word[0])
  .filter(Boolean)
  .slice(0, 2)
  .join('')
  .toUpperCase();

const cardLink = tv({
  base: ['project-card group card card-hover-subtle flex h-full flex-col rounded-2xl p-4 md:p-5', focusRing()]
});
---

<a href={`/projects/${project.id}`} class={cardLink()}>
  <div class="relative w-full">
    {
      project.data.cover ? (
        <Picture
          src={project.data.cover}
          alt={project.data.coverAlt ?? project.data.title}
          widths={[640, 960, 1280]}
          sizes={featured ? '(min-width: 768px) 640px, 100vw' : '(min-width: 768px) 360px, 100vw'}
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          quality={68}
          loading={index < 2 ? 'eager' : 'lazy'}
          decoding={index === 0 ? 'sync' : 'async'}
          fetchpriority={index === 0 ? 'high' : 'auto'}
          pictureAttributes={{ class: mediaFrame({ featured }) }}
          class="size-full object-cover object-top transition duration-[var(--motion-duration-reveal)] ease-[var(--motion-ease-settle)] group-hover:scale-[1.015]"
        />
      ) : (
        <div class={`${mediaFrame({ featured })} flex items-center justify-center bg-gradient-to-br ${project.data.accent}`}>
          {project.data.icon ? (
            <Icon
              name={project.data.icon}
              style={project.data.iconColor ? { color: project.data.iconColor } : undefined}
              class={projectIcon({ compact, small: isSmallBrandIcon })}
              aria-hidden="true"
            />
          ) : (
            <span class="font-display text-overlay-fg/85 text-7xl tracking-tighter mix-blend-overlay md:text-8xl">{initials}</span>
          )}
        </div>
      )
    }
  </div>

  <div class={`flex min-w-0 flex-1 flex-col gap-3 px-1 pt-4 pb-1 md:px-2 ${compact ? 'md:pt-4 md:pb-1' : 'md:pt-5 md:pb-2'}`}>
    <HeadingTag class={`font-display break-words ${compact ? 'text-2xl' : 'text-2xl md:text-3xl'}`}>{project.data.title}</HeadingTag>
    <p class="text-accent font-mono text-sm break-words">{project.data.subtitle}</p>
    <p class="text-fg-muted leading-relaxed break-words">{project.data.summary}</p>
    {
      featured && projectSkills.length ? (
        <ul class="mt-auto hidden flex-wrap gap-3 pt-6 md:flex md:gap-4" aria-label={`${project.data.title} skills used`}>
          {projectSkills.map((skill: Skill) => (
            <li>
              <div class="skill-badge">
                <Icon name={skill.icon} class={skillIcon({ tone: skill.iconTone, class: 'size-5 md:size-6' })} aria-hidden="true" />
                <span class="text-fg/90 min-w-0 text-sm font-semibold tracking-wide break-words">{skill.name}</span>
              </div>
            </li>
          ))}
        </ul>
      ) : null
    }
  </div>
</a>
