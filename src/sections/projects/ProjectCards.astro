---
import type { CollectionEntry } from 'astro:content';
import ProjectCard from '~/sections/projects/ProjectCard.astro';
import Reveal from '~/components/Reveal.astro';

type ProjectEntry = CollectionEntry<'projects'>;

type Props = {
  projects: ProjectEntry[];
};

const { projects } = Astro.props;

const featuredProjects = projects.slice(0, 3);
const remainingProjects = projects.slice(3);
---

<ul class="grid grid-cols-1 gap-6 md:grid-cols-6 md:gap-8">
  {
    featuredProjects[0] && (
      <Reveal as="li" delay={0} class="md:col-span-4">
        <ProjectCard project={featuredProjects[0]} index={0} featured />
      </Reveal>
    )
  }
  <li class="grid gap-6 md:col-span-2 md:gap-6">
    <ul class="grid gap-6 md:gap-6">
      {
        featuredProjects.slice(1).map((project: ProjectEntry, index: number) => (
          <Reveal as="li" delay={(index + 1) * 80}>
            <ProjectCard project={project} index={index + 1} compact />
          </Reveal>
        ))
      }
    </ul>
  </li>
  {
    remainingProjects.map((project: ProjectEntry, index: number) => (
      <Reveal as="li" delay={(index + 3) * 80} class="md:col-span-2">
        <ProjectCard project={project} index={index + 3} />
      </Reveal>
    ))
  }
</ul>
