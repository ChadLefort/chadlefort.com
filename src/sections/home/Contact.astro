---
import { Icon } from 'astro-icon/components';
import { Button } from '~/components/Button';
import { ButtonLink } from '~/components/ButtonLink';
import Section from '~/components/Section.astro';
import { site } from '~/data/site';

const contactLinks = [
  { label: site.email, href: `mailto:${site.email}`, icon: 'lucide:mail', copy: true },
  { label: 'Github', href: site.social.github, icon: 'simple-icons:github' },
  { label: 'LinkedIn', href: site.social.linkedin, icon: 'simple-icons:linkedin' },
  { label: 'X', href: site.social.x, icon: 'simple-icons:x' },
  { label: 'Instagram', href: site.social.instagram, icon: 'simple-icons:instagram' },
  { label: 'YouTube', href: site.social.youtube, icon: 'simple-icons:youtube' }
];

---

<Section id="contact" title="Contact" tone="plain" tile={false} titleAlign="left" class="home-split-section" hideFromPrint>
  <address class="not-italic">
    <div class="grid gap-3 md:grid-cols-2 xl:grid-cols-3" aria-label="Contact links">
      {
        contactLinks.map((link) => {
          const content = (
            <>
              <Icon name={link.icon} class="text-accent h-5 w-5 shrink-0" aria-hidden="true" />
              <span class="min-w-0 truncate" data-copy-email-label={link.copy ? true : undefined}>{link.label}</span>
              {
                link.copy && (
                  <Icon
                    name="lucide:copy"
                    class="text-fg-muted group-hover:text-accent ml-auto h-4 w-4 shrink-0 transition"
                    aria-hidden="true"
                    data-copy-email-icon
                  />
                )
              }
            </>
          );

          return (
            <div>
              {
                link.href ? (
                  link.copy ? (
                    <Button
                      type="button"
                      variant="card"
                      data-copy-email
                      data-email={site.email}
                      className="min-h-12 w-full justify-start gap-3 px-4 py-3 text-left font-mono text-sm"
                      aria-label={`Copy email ${site.email} to clipboard`}
                    >
                      {content}
                    </Button>
                  ) : (
                    <ButtonLink
                      href={link.href}
                      rel="noopener"
                      target="_blank"
                      variant="card"
                      className="min-h-12 w-full justify-start gap-3 px-4 py-3 text-left font-mono text-sm"
                    >
                      {content}
                    </ButtonLink>
                  )
                ) : (
                  <span class="card card-hover text-fg inline-flex min-h-12 w-full items-center justify-start gap-3 rounded-2xl px-4 py-3 text-left font-mono text-sm">
                    {content}
                  </span>
                )
              }
            </div>
          );
        })
      }
    </div>

    <p class="sr-only" data-copy-email-status aria-live="polite"></p>
  </address>
</Section>

<script>
  const init = () => {
    document.querySelectorAll<HTMLButtonElement>('[data-copy-email]').forEach((btn) => {
      if (btn.dataset.copyEmailBound) return;

      btn.dataset.copyEmailBound = 'true';

      const label = btn.querySelector<HTMLElement>('[data-copy-email-label]');
      const status = btn.closest('address')?.querySelector<HTMLElement>('[data-copy-email-status]');
      const original = label?.textContent ?? '';

      btn.addEventListener('click', async () => {
        const email = btn.dataset.email ?? '';

        try {
          await navigator.clipboard.writeText(email);
        } catch {
          if (status) status.textContent = `Copy failed. Email ${email} manually.`;
          return;
        }

        btn.classList.remove('copy-email-confirmed');
        window.requestAnimationFrame(() => btn.classList.add('copy-email-confirmed'));

        if (label) label.textContent = 'Email copied!';
        if (status) status.textContent = 'Email copied to clipboard.';

        window.setTimeout(() => {
          btn.classList.remove('copy-email-confirmed');
          if (label) label.textContent = original;
          if (status) status.textContent = '';
        }, 1800);
      });
    });
  };

  document.addEventListener('astro:page-load', init);
  init();
</script>
