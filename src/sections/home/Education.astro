---
import Nicholls from '~/assets/logos/nicholls.svg';
import Section from '~/components/Section.astro';
import { education } from '~/data/education';
import { formatMonthYear, toYearMonthDateTime } from '~/utils/date';
---

<Section id="education" title="Education" tone="plain" tile={false} titleAlign="left" class="home-split-section print:break-inside-avoid">
  <article class="w-full max-w-5xl print:resume-edu-article print:pb-[0.05in]">
    <header class="grid grid-cols-[minmax(0,1fr)_5rem] items-start gap-4 text-left md:grid-cols-[1fr_auto] md:items-center md:gap-8 print:resume-edu-header">
      <div class="min-w-0">
        <h3 class="font-display text-[1.5rem] leading-[1.05] md:text-3xl print:resume-edu-title">{education.institution}</h3>
        <p class="text-accent mt-2 text-sm leading-snug font-semibold md:mt-1 md:text-base print:resume-edu-degree">{education.degree}</p>
        <p class="text-fg-muted mt-2 font-mono text-xs leading-snug md:mt-1 md:text-sm print:resume-edu-dates">
          <time datetime={toYearMonthDateTime(education.start)}>{formatMonthYear(education.start)}</time> &ndash;{' '}
          <time datetime={toYearMonthDateTime(education.end)}>{formatMonthYear(education.end)}</time>
        </p>
      </div>
      <Nicholls aria-hidden="true" focusable="false" class="mt-1 h-9 w-auto justify-self-end md:mt-0 md:h-20 print:h-10 print:resume-edu-logo" />
    </header>

    <hr class="border-panel-border-strong my-6 border-t print:resume-edu-hr" />

    <ul class="text-fg-muted space-y-2 print:resume-edu-list">
      <li class="flex gap-3">
        <span aria-hidden="true" class="bg-accent mt-2 inline-block size-1.5 shrink-0 rounded-full"></span>
        <span>Majored in {education.major}</span>
      </li>
      <li class="flex gap-3">
        <span aria-hidden="true" class="bg-accent mt-2 inline-block size-1.5 shrink-0 rounded-full"></span>
        <span>GPA: {education.gpa}</span>
      </li>
    </ul>

    <section class="mt-10 print:mt-0" aria-labelledby="education-awards-title">
      <h4 id="education-awards-title" class="font-display text-lg md:text-xl print:resume-edu-subtitle">Awards</h4>
      <ul class="text-fg-muted mt-3 space-y-2 print:resume-edu-list">
        {
          education.awards.map((award) => (
            <li class="flex gap-3">
              <span aria-hidden="true" class="bg-accent mt-2 inline-block size-1.5 shrink-0 rounded-full" />
              <span>{award}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-10 print:mt-0" aria-labelledby="education-organizations-title">
      <h4 id="education-organizations-title" class="font-display text-lg md:text-xl print:resume-edu-subtitle">Organizations</h4>
      <ul class="text-fg-muted mt-3 space-y-2 print:resume-edu-list">
        {
          education.organizations.map((org) => (
            <li class="flex gap-3">
              <span aria-hidden="true" class="bg-accent mt-2 inline-block size-1.5 shrink-0 rounded-full" />
              <span>{org}</span>
            </li>
          ))
        }
      </ul>
    </section>
  </article>
</Section>
