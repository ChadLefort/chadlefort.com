---
import { tv } from 'tailwind-variants';

type Props = {
  id: string;
  tone?: 'base' | 'alt' | 'hero' | 'plain';
  class?: string;
  title?: string;
  as?: 'section' | 'div';
  hideFromPrint?: boolean;
  printOnly?: boolean;
  titleAlign?: 'center' | 'left';
  width?: 'narrow' | 'wide' | 'full';
  tile?: boolean;
};

const {
  id,
  tone = 'base',
  class: className,
  title,
  as: Tag = 'section',
  hideFromPrint = false,
  printOnly = false,
  titleAlign = 'center',
  width = 'wide',
  tile = true
} = Astro.props as Props;

const section = tv({
  base: 'relative scroll-mt-16 px-6 py-5 sm:px-8 sm:py-8 md:px-6 md:py-16 print:p-0 print:mb-[0.28in]'
});

const tile$ = tv({
  base: 'relative mx-auto w-full px-5 py-10 sm:px-10 sm:py-14 md:py-28 lg:px-16 print:p-0 print:bg-transparent print:border-0 print:rounded-none print:max-w-full',
  variants: {
    width: {
      narrow: 'max-w-4xl',
      wide: 'max-w-section',
      full: 'max-w-shell'
    },
    tone: {
      base: 'bg-tile border-panel-border rounded-3xl border',
      alt: 'bg-tile-alt border-panel-border rounded-3xl border',
      hero: 'bg-tile border-panel-border rounded-3xl border',
      plain: ''
    },
    tileOff: {
      true: '!border-0 !bg-transparent'
    }
  }
});

const header = tv({
  base: 'mb-8 flex flex-col gap-4 sm:mb-12 md:mb-20 print:mb-[0.1in] print:items-center',
  variants: {
    align: {
      center: 'items-center text-center',
      left: 'section-rail mb-8 items-start text-left md:sticky md:top-24 md:mb-0 md:self-start'
    }
  }
});

const tileOff = !tile || tone === 'plain';
const splitTitle = title && titleAlign === 'left';
---

<Tag
  id={id}
  class={section({ class: className })}
  data-no-print={hideFromPrint ? true : undefined}
  data-print-only={printOnly ? true : undefined}
>
  <div class={tile$({ width, tone, tileOff })}>
    {
      splitTitle ? (
        <div class="md:grid md:grid-cols-[minmax(14rem,20rem)_minmax(0,1fr)] md:gap-0">
          <header class={header({ align: titleAlign })}>
            <h2 class="font-display text-3xl md:text-4xl print:resume-section-title">{title}</h2>
          </header>
          <div class="min-w-0">
            <slot />
          </div>
        </div>
      ) : (
        <>
          {
            title && (
              <header class={header({ align: titleAlign })}>
                <h2 class="font-display text-4xl md:text-6xl print:resume-section-title">{title}</h2>
              </header>
            )
          }
          <slot />
        </>
      )
    }
  </div>
</Tag>
