{
  "name": "chadlefort.com",
  "private": true,
  "description": "Personal website",
  "version": "3.1.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.10",
  "repository": {
    "type": "git",
    "url": "https://github.com/ChadLefort/chadlefort.com.git"
  },
  "scripts": {
    "dev": "astro dev --host",
    "start": "astro dev --host",
    "prebuild": "bun scripts/generate-build-info.ts",
    "build": "astro build",
    "assets:brand": "bun scripts/generate-brand-assets.ts",
    "assets:favicon": "bun scripts/generate-favicon.ts",
    "hooks:install": "bun scripts/install-git-hooks.ts",
    "hooks:list": "git hook list pre-commit",
    "hooks:uninstall": "bun scripts/uninstall-git-hooks.ts",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "biome check . --files-ignore-unknown=true",
    "lint:fix": "biome check . --write --files-ignore-unknown=true",
    "format": "biome format . --write --files-ignore-unknown=true",
    "format:check": "biome format . --files-ignore-unknown=true",
    "typecheck": "astro check && tsgo --noEmit && bun run typecheck:scripts",
    "typecheck:tsc": "astro check && tsc --noEmit && bun run typecheck:scripts",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json --noEmit",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:e2e:ui": "playwright test --ui",
    "audit": "fallow audit",
    "dead-code": "fallow dead-code",
    "dupes": "fallow dupes",
    "health": "fallow health",
    "fallow:fix": "fallow fix --yes",
    "fallow:fix:preview": "fallow fix --dry-run",
    "prepare": "bun run hooks:install"
  },
  "dependencies": {
    "@astrojs/mdx": "7.0.0",
    "@astrojs/react": "6.0.0",
    "@astrojs/sitemap": "3.7.3",
    "@iconify-icons/simple-icons": "1.2.74",
    "@iconify-json/lucide": "1.2.114",
    "@iconify-json/mdi": "1.2.3",
    "@iconify-json/simple-icons": "1.2.87",
    "@iconify/react": "6.0.2",
    "@js-temporal/polyfill": "0.5.1",
    "@nanostores/react": "1.1.0",
    "@tailwindcss/vite": "4.3.1",
    "astro": "7.0.3",
    "astro-icon": "1.1.5",
    "dedent": "1.7.2",
    "lucide-react": "1.21.0",
    "nanostores": "1.3.0",
    "react": "19.2.7",
    "react-aria": "3.50.0",
    "react-aria-components": "1.19.0",
    "react-dom": "19.2.7",
    "sharp": "0.35.2",
    "tailwind-merge": "3.6.0",
    "tailwind-variants": "3.2.2",
    "tailwindcss": "4.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@biomejs/biome": "2.5.1",
    "@iconify-json/devicon": "1.2.62",
    "@playwright/test": "1.61.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/bun": "1.3.14",
    "@types/node": "26.0.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260626.1",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "4.1.9",
    "@vitest/ui": "4.1.9",
    "axe-core": "4.12.1",
    "fallow": "2.102.0",
    "happy-dom": "20.10.6",
    "lint-staged": "17.0.8",
    "sharp-ico": "0.1.5",
    "typescript": "6.0.3",
    "vitest": "4.1.9",
    "vitest-axe": "0.1.0"
  }
}
